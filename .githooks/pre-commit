#!/bin/sh

set -eu

canonical_goldens=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD -- \
  | grep -E '^test/(.*/)?goldens?/.*\.png$' || true)

if [ -z "$canonical_goldens" ]; then
  exit 0
fi

echo 'Canonical golden files are generated by CI and cannot be committed locally.' >&2
echo 'Run the "Update canonical goldens" GitHub Actions workflow for the pull request.' >&2
echo '' >&2
echo 'Staged canonical golden files:' >&2
echo "$canonical_goldens" >&2
exit 1
