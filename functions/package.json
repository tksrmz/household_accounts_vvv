{
  "name": "functions",
  "scripts": {
    "check:node": "node scripts/check-node-version.cjs",
    "prelint": "npm run check:node",
    "lint": "eslint .",
    "prelint-fix": "npm run check:node",
    "lint-fix": "eslint . --fix",
    "prebuild": "npm run check:node",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "predeploy": "npm run check:node",
    "deploy": "firebase deploy --only functions",
    "prelogs": "npm run check:node",
    "logs": "firebase functions:log",
    "pretest": "npm run check:node",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "engines": {
    "node": "22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22",
      "onFail": "error"
    }
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.1.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "private": true
}
