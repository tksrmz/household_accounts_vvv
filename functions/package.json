{
  "name": "functions",
  "scripts": {
    "check:node": "node scripts/check-node-version.cjs",
    "prelint": "npm run check:node",
    "lint": "eslint .",
    "prelint-fix": "npm run check:node",
    "lint-fix": "eslint . --fix",
    "prebuild": "npm run check:node",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "predeploy": "npm run check:node",
    "deploy": "firebase deploy --only functions",
    "prelogs": "npm run check:node",
    "logs": "firebase functions:log",
    "pretest": "npm run check:node",
    "test": "jest"
  },
  "engines": {
    "node": "22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22",
      "onFail": "error"
    }
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "private": true
}
