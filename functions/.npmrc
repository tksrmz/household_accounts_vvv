# firebase-functions v7 は peerDependencies で firebase-admin ^11 || ^12 || ^13
# しか宣言していないため、firebase-admin v14 と組み合わせると npm install が
# ERESOLVE で失敗する。動作上は問題ないことが確認されているので legacy モード
# で回避している。upstream の追跡: https://github.com/firebase/firebase-functions/issues/1902
# firebase-functions 側で peer が更新されたら、上記コメントと
# legacy-peer-deps=true の行だけを削除すること。
legacy-peer-deps=true

# package.json の engines.node を依存関係のインストール時にも強制する。
engine-strict=true
