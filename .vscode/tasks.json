{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dart",
			"command": "dart",
			"args": [
				"run",
				"build_runner",
				"test"
			],
			"problemMatcher": [
				"$dart-build_runner"
			],
			"group": "test",
			"label": "dart: dart run build_runner test",
			"detail": ""
		},
		{
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/../household_accounts_firebase"
			},
			"command": "firebase",
			"args": [
				"emulators:exec",
				"--only",
				"auth,firestore,functions",
				"--import=${workspaceFolder}/integration_test/saved-data",
				"${workspaceFolder}/integration_test/run.sh",
			],
			"problemMatcher": [
				"$dart-build_runner"
			],
			"group": "test",
			"label": "integration test",
		}
	]
}
