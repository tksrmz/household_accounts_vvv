# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Web related
lib/generated_plugin_registrant.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Ignore golden test failure diffs (baseline images under golden/goldens ARE committed)
test/**/failures/**/*.*

# Ignore OS-specific local golden baselines (canonical baselines are CI-generated)
test/**/golden/.local/
test/**/goldens/.local/

# Ignore files generated by Freezed
**.freezed.dart
**.g.dart

# Firebase configuration files
**/GoogleService-Info.plist
**/firebase_app_id_file.json

# Android release signing (never commit keystores or their credentials)
android/key.properties
*.jks
*.keystore

# Ignore files generated by mockito
**.mocks.dart

# Ignore prompt files
.prompt/
